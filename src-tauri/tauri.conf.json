{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cleany",
  "mainBinaryName": "Cleany",
  "version": "0.1.1",
  "identifier": "com.tansuasici.cleany",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cleany",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; worker-src 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "msi", "appimage", "deb", "rpm"],
    "category": "Utility",
    "shortDescription": "Disk usage analyzer and cleaner",
    "longDescription": "Cleany shows what is using your disk space in detail and lets you clean it up safely.",
    "copyright": "© 2026 Tansu Aşıcı and Cleany contributors",
    "license": "MIT OR Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "files": {
        "Library/LaunchAgents/com.tansuasici.cleany.login.plist": "./macos/com.tansuasici.cleany.login.plist"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxQzNCMjU1RjJFREEwNTAKUldSUW9PM3lWYkxEWVhpZlI5SXlRQXUwQU11eFUvMlBVZDV0emtvT25TQ1RlQzhnbDhRNGpQM2YK",
      "endpoints": [
        "https://github.com/tansuasici/Cleany/releases/latest/download/latest.json"
      ]
    }
  }
}
